# Get a key at https://console.deepgram.com/
DEEPGRAM_API_KEY=your_deepgram_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here
# Optional fallback keys. When one key hits its daily/free limit, MEETR switches
# to the next one automatically. Add up to OPENROUTER_API_KEY_5, or put several
# keys on OPENROUTER_API_KEY separated by commas.
# OPENROUTER_API_KEY_2=your_second_openrouter_api_key_here
# Get a key at https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here
# Optional model override; defaults to openai/gpt-oss-20b.
GROQ_MODEL=openai/gpt-oss-20b
